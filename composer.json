{
    "name": "ilhamramadhan/portfolio",
    "description": "Cinematic & Minimal Portfolio for Filmmaker & Photographer Ilham Ramadhan Setiawan",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Ilham Ramadhan Setiawan",
            "role": "Videographer & Photographer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.5",
        "google/apiclient": "^2.15"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Models\\": "models/",
            "App\\Services\\": "services/"
        },
        "files": [
            "includes/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
