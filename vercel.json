{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": [
        "config/**",
        "data/**",
        "includes/**",
        "models/**",
        "services/**",
        "*.php"
      ]
    }
  },
  "routes": [
    { "src": "^/assets/(.*)$", "dest": "/assets/$1" },
    { "src": "^/data/(.*)$",   "dest": "/data/$1" },
    { "src": ".*",             "dest": "/api/index.php" }
  ]
}
