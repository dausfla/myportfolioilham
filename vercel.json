{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "^/$",                              "dest": "/api/index.php" },
    { "src": "^/about/?$",                       "dest": "/api/about.php" },
    { "src": "^/work/?$",                        "dest": "/api/work.php" },
    { "src": "^/contact/?$",                     "dest": "/api/contact.php" },
    { "src": "^/admin/?$",                       "dest": "/api/admin.php" },
    { "src": "^/admin\\.php(.*)$",               "dest": "/api/admin.php$1" },
    { "src": "^/project/([a-zA-Z0-9\\-]+)/?$",   "dest": "/api/project.php?slug=$1" },
    { "src": "^/(assets/.*)$",                   "dest": "/$1" },
    { "src": "^/(data/.*)$",                     "dest": "/$1" },
    { "src": "^/(.+\\.php)(.*)$",                "dest": "/api/$1$2" },
    { "src": ".*",                               "dest": "/api/404.php" }
  ]
}
